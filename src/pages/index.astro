---
import BaseLayout from "@/layouts/BaseLayout.astro"

{/*
funzione per simulare chiamata al server per check se lo user esiste o meno
di conseguenza preparare la giusta risposta del frontend per entrambi i casi
*/}
const getUser = () => {
	return Math.random() < 0.5 ? null : {
		name: 'Mario',
		email: 'mario@bookbites.com',
	}
}
const user = getUser()
---

<BaseLayout>
	<div class="content">
		{user && (
			<h2>Welcome, {user.name}</h2>
			<p>Logged in as: {user.email}</p>
		)}
		<h2>Welcome</h2>
		<p>Do you want to login?</p>
		<p>Lorem, ipsum dolor sit amet consectetur adipisicing elit. Recusandae enim est debitis voluptates nisi in iure ut quo eum? Error ea iusto magnam omnis nostrum reprehenderit id quidem possimus voluptatem.</p>
		<a href="/books">Take a look</a>
	</div>
</BaseLayout>

<style>
	.content {
		text-align: center;
	}
	a {
		display: inline-block;
		background-color: #7a49c5;
		color: #fff;
		padding: 6px 10px;
		border-radius: 2px;
		text-decoration: none;
		margin-top: 20px;
	}
	a:hover {
			background-color: #965ee9;
		}
</style>