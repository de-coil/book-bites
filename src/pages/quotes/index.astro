---
export const prerender = false

import BaseLayout from "@/layouts/BaseLayout.astro"

interface Quote {
  quote: string
  author: string
}

let quotes: Quote[] = []
let error: string | null = null

try {
  const response = await fetch('https://dummyjson.com/quotes')
  if (!response.ok) {
    throw new Error(`Failed to fetch quotes: ${response.status}`)
  }
  const json = await response.json()
  quotes = json.quotes || []
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load quotes'
}
---

<BaseLayout>
  <div class="content">
    <h2>Inspiring Quotes</h2>
    
    {error && (
      <div class="error-message">
        <p>{error}</p>
        <p>Please try again later.</p>
      </div>
    )}
    
    {!error && quotes.length === 0 && (
      <p>No quotes available at the moment.</p>
    )}
    
    {!error && quotes.length > 0 && (
      <div class="quotes-grid">
        {quotes.map((q, index) => (
          <div class="quote-card">
            <div class="quote-number">#{index + 1}</div>
            <blockquote class="quote-text">{q.quote}</blockquote>
            <cite class="quote-author">— {q.author}</cite>
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .content {
    text-align: center;
  }

  .content h2 {
    font-size: 2em;
    margin-bottom: 40px;
    font-family: 'Righteous', cursive;
  }

  .error-message {
    background-color: #fee;
    border: 2px solid #fcc;
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
    color: #c33;
  }

  .quotes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 30px;
    text-align: left;
  }

  .quote-card {
    background-color: var(--card-bg);
    padding: 24px;
    border-radius: 8px;
    box-shadow: 8px 8px 0 var(--shadow-color);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .quote-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 var(--shadow-color);
  }

  .quote-number {
    position: absolute;
    top: -12px;
    left: 20px;
    background-color: var(--accent-primary);
    color: #fff;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.85em;
    font-weight: 600;
  }

  .quote-text {
    font-size: 1.1em;
    line-height: 1.6;
    margin: 16px 0 20px 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .quote-author {
    display: block;
    text-align: right;
    font-size: 1em;
    color: var(--accent-primary);
    font-weight: 500;
    font-style: normal;
  }
</style>