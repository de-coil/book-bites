---
import type { CollectionEntry } from 'astro:content'

interface Props {
  book: CollectionEntry<'books'>
}
const { book } = Astro.props
---

<div class="book-card">
  <p class="book-title">{book.data.title}, {book.data.rating}/10</p>
  <p class="book-author">{book.data.author}</p>
  <p class="book-summary">{book.data.summary}</p>
  <a href={`/books/${book.id}`}>Read Review</a>
</div>

<style>
	.book-card {
		background-color: var(--card-bg);
		padding: 16px 20px;
		margin: 20px auto;
		box-shadow: 8px 8px 0 var(--shadow-color);
		border-radius: 8px;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}
	.book-card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 10px 10px 0 var(--shadow-color);
	}
	.book-title {
		font-size: 1.4em;
		font-weight: bold;
		margin: 0;
		color: var(--text-primary);
	}
	.book-author {
		margin-top: 0;
		color: var(--text-secondary);
	}
	.book-summary {
		font-size: 1em;
		color: var(--text-secondary);
	}
	a {
		display: inline-block;
		background-color: var(--accent-primary);
		color: #fff;
		padding: 8px 16px;
		border-radius: 4px;
		text-decoration: none;
		margin-top: 10px;
		transition: background-color 0.3s ease;
	}
	a:hover {
		background-color: var(--accent-hover);
	}
</style>