{/*
il tag style viene applicato solo al componente dove viene invocato, 
per applicarlo anche agli altri componenti invocati (nel nostro caso BaseLayout) aggiungere is:global
vedi piu in basso
*/}

<style >
	body {
		margin: 0;
	}
	header {
		background-color: #efe7fa;
		padding: 10px 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		box-shadow: 0 8px 0 #dcd0ea;

		h1 {
			margin: 0;
		}
		ul {
			display: flex;
			list-style-type: none;
			gap: 16px;
		}
		a {
			text-decoration: none;
			border-bottom: 1px dashed;
		}
	}
</style>

<style is:global>
	* {
		font-family: 'Poppins', sans-serif;
		color: #333;
	}
	.content {
		width: 100%;
		max-width: 1200px;
		margin: 60px auto;
		padding: 0 20px;
		box-sizing: border-box;

		h2 {
			font-size: 1.8em;
		}
		p {
			font-size: 1.2em;
		}
	}
	.likes {
		border-top: 1px dashed rgb(135, 135, 215);
		background-color: #f9f6fc;
		margin-top: 40px;
		display: flex;
		padding: 10px;
		gap: 20px;
		align-items: center;

		button {
			background-color: #c194ef;
			border: 0;
			color: #fff;
			padding: 6px 10px;
			font-size: 1em;
			border-radius: 4px;
			cursor: pointer;
		}
	}
</style>